# --- Required ---
# Get a free key, no credit card needed, at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# "free" (default) or "pro" — switch to "pro" once you've attached billing to your
# Google AI Studio project. See README's "Free tier vs Pro tier" section.
GEMINI_TIER=free

# --- Only needed if you run a live CTFd competition (skip for --screenshot/--url) ---
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# --- Optional: only needed if you explicitly pass --models/--coordinator using
#     the paid claude-sdk/codex backends instead of Gemini ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
